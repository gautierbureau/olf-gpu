<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- Codegen output (codegen/generate.py): dense machine-emitted math expressions that
         exceed the 200-char line limit. These files are GENERATED — DO NOT EDIT / hand-wrap;
         they are re-rendered from the residual specs, so the length is suppressed here rather
         than by editing the generated Java. -->
    <suppress files="[/\\](OpenBranchFormulas|OpenBranchCurrentMagnitudeFormulas|HvdcAcEmulationFormulas)\.java"
              checks="LineLength"/>

    <!-- GPU native-boundary code deliberately catches broad exceptions (RuntimeException /
         Exception / Throwable) so a device/driver/cuDSS failure at runtime falls back to the
         CPU path instead of aborting the load flow. A narrow catch cannot cover arbitrary JNI
         failures, so IllegalCatch is suppressed for the GPU sources. -->
    <suppress files="[/\\]ac[/\\]equations[/\\]vector[/\\]gpu[/\\].*\.java" checks="IllegalCatch.*"/>
    <suppress files="[/\\]Gpu[^/\\]*\.java" checks="IllegalCatch.*"/>

    <!-- GpuAcDataExtractor.extract is a single cohesive pass that builds every per-family flat
         pack in one place; splitting it would scatter tightly-coupled index bookkeeping. -->
    <suppress files="[/\\]GpuAcDataExtractor\.java" checks="MethodLength"/>

    <!-- GpuBatchChunkSolver.solveQualifiedInChunks assembles ~30 per-scenario device buffers (masks,
         row modes, target / tap / shunt / distributed-slack overrides, zero-impedance enable+disable
         slots) that are all reused across chunks and mutated in lockstep. Splitting it would mean
         threading every buffer through a parameter object for no readability gain. -->
    <suppress files="[/\\]GpuBatchChunkSolver\.java" checks="MethodLength"/>

    <!-- GpuHybridBatchOuterLoopEngine.solve replays OLF's engine loop (outer-loop iteration, snapshot
         save/restore, device re-solve, status bookkeeping) as ONE state machine whose locals are the
         engine state; GpuBatchSecondaryVc.orchestrate is the same shape for the zone-system replay.
         Both are validated at 1e-12 against the CPU — splitting them means threading the full state
         through parameter objects for no readability gain (same rationale as GpuBatchChunkSolver). -->
    <suppress files="[/\\]GpuHybridBatchOuterLoopEngine\.java" checks="MethodLength"/>
    <suppress files="[/\\]GpuBatchSecondaryVc\.java" checks="MethodLength"/>

    <!-- GpuCpuPureInnerProbe is the frozen LINE-26-4231 diagnostic: its bare blocks deliberately
         scope each probe stage's locals (saved loops, reset targets) so stages cannot leak into
         each other. Kept verbatim as the investigation record. -->
    <suppress files="[/\\]GpuCpuPureInnerProbe\.java" checks="AvoidNestedBlocks"/>
</suppressions>
