+
+    @Test
+    void incrementalVariableRowsMatchAFullSort() {
+        LfNetwork network = Mockito.mock(LfNetwork.class);
+        EquationSystem<TestVariableType, TestEquationType> equationSystem = new EquationSystem<>(TestEquationType.class, network);
+        int elementCount = 40;
+        List<SingleEquationTerm<TestVariableType, TestEquationType>> terms = new ArrayList<>();
+        for (int num = 0; num < elementCount; num++) {
+            var x = equationSystem.createEquation(num, TestEquationType.X);
+            var y = equationSystem.createEquation(num, TestEquationType.Y);
+            for (TestVariableType type : TestVariableType.values()) {
+                // two terms per variable, so that a variable can lose a reference and stay
+                SingleEquationTerm<TestVariableType, TestEquationType> t1 = equationSystem.getVariableSet().getVariable(num, type).createTerm();
+                SingleEquationTerm<TestVariableType, TestEquationType> t2 = equationSystem.getVariableSet().getVariable((num + 7) % elementCount, type).createTerm();
+                x.addTerm(t1);
+                y.addTerm(t2);
+                terms.add(t1);
+                terms.add(t2);
+            }
+        }
+        EquationSystemIndex<TestVariableType, TestEquationType> index = equationSystem.getIndex();
+        Random random = new Random(42);
+        List<Variable<TestVariableType>> previous = index.getSortedVariablesToFind();
+        TreeSet<Variable<TestVariableType>> previousExpected = expectedVariables(terms);
+        boolean previousSeparated = false;
+        boolean variableEventSinceBuild = false;
+        for (int step = 0; step < 3000; step++) {
+            int changes = random.nextInt(4);
+            for (int c = 0; c < changes; c++) {
+                var before = expectedVariables(terms);
+                var term = terms.get(random.nextInt(terms.size()));
+                term.setActive(!term.isActive());
+                variableEventSinceBuild |= !expectedVariables(terms).equals(before);
+            }
+            if (random.nextInt(3) != 0) {
+                continue; // let changes accumulate, and cancel, between rebuilds
+            }
+            TreeSet<Variable<TestVariableType>> expected = expectedVariables(terms);
+            boolean separated = random.nextInt(10) == 0;
+            if (separated) {
+                index.updateWithSeparation(t -> t == TestEquationType.X, t -> t == TestVariableType.A);
+            }
+            List<Variable<TestVariableType>> variables = index.getSortedVariablesToFind();
+            if (separated || previousSeparated && !variableEventSinceBuild) { // the index stays valid until a variable event
+                List<Variable<TestVariableType>> expectedOrder = new ArrayList<>(expected.stream().filter(v -> v.getType() == TestVariableType.A).toList());
+                expectedOrder.addAll(expected.stream().filter(v -> v.getType() != TestVariableType.A).toList());
+                assertEquals(expectedOrder, variables);
+            } else {
+                assertEquals(List.copyOf(expected), variables);
+                if (expected.equals(previousExpected) && !previousSeparated) {
+                    assertSame(previous, variables); // a change that cancelled out keeps the index
+                }
+            }
+            for (int row = 0; row < variables.size(); row++) {
+                assertEquals(row, variables.get(row).getRow());
+            }
+            for (int num = 0; num < elementCount; num++) {
+                for (TestVariableType type : TestVariableType.values()) {
+                    var v = equationSystem.getVariableSet().getVariable(num, type);
+                    if (!expected.contains(v)) {
+                        assertEquals(-1, v.getRow());
+                    }
+                }
+            }
+            assertEquals(variables.size(), index.getRowCount());
+            previous = variables;
+            previousExpected = expected;
+            previousSeparated = separated || previousSeparated && !variableEventSinceBuild;
+            variableEventSinceBuild = false;
+        }
+    }
+
+    private static TreeSet<Variable<TestVariableType>> expectedVariables(List<SingleEquationTerm<TestVariableType, TestEquationType>> terms) {
+        TreeSet<Variable<TestVariableType>> expected = new TreeSet<>();
+        for (var term : terms) {
+            if (term.isActive() && term.getEquation().isActive()) {
