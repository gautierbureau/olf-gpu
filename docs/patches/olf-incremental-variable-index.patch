+            while (addedIndex < added.size() && added.get(addedIndex).compareTo(kept) < 0) {
+                appendWithRow(merged, added.get(addedIndex++));
+            }
+            appendWithRow(merged, kept);
+        }
+        while (addedIndex < added.size()) {
+            appendWithRow(merged, added.get(addedIndex++));
+        }
+        sortedVariablesToFind = Collections.unmodifiableList(merged);
+    }
