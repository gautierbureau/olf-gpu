+    private void mergePendingVariables() {
+        List<Variable<V>> previous = sortedVariablesToFind;
+        List<Variable<V>> added = new ArrayList<>(pendingAddedVariables);
+        Collections.sort(added);
+        int[] removedRows = pendingRemovedVariableRows.values().stream().mapToInt(Integer::intValue).sorted().toArray();
+        int firstChange = removedRows.length > 0 ? removedRows[0] : previous.size();
+        if (!added.isEmpty()) {
+            int insertion = Collections.binarySearch(previous, added.get(0));
+            firstChange = Math.min(firstChange, -insertion - 1);
+        }
+        List<Variable<V>> merged = new ArrayList<>(previous.size() + added.size() - removedRows.length);
+        merged.addAll(previous.subList(0, firstChange));
+        int removedIndex = 0;
+        int addedIndex = 0;
+        for (int i = firstChange; i < previous.size(); i++) {
+            if (removedIndex < removedRows.length && removedRows[removedIndex] == i) {
+                removedIndex++;
+                continue;
+            }
